{
  "manifest_version": 3,
  "name": "Passive Investment Analyst",
  "version": "1.6.3",
  "description": "Upcoming earnings, insider buying and prices for the stocks you track \u2014 every time you open a tab.",
  "minimum_chrome_version": "115",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.finnhub.io/*",
    "https://api.nasdaq.com/*",
    "https://financialmodelingprep.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
